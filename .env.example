# LLM — Bedrock 모델 접근 활성화됨. 로컬 검증은 mock, 실분석은 bedrock(AWS 자격증명 필요)
LLM_MODE=mock
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=ap-northeast-2

# Slack (미설정이면 콘솔 dry-run)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# 게이트 튜닝
G1_COOLDOWN_SECONDS=3600
G2_WINDOW_SECONDS=300
G2_STORM_THRESHOLD=15
G4_DAILY_CAP=200
G4_AUTO_WARNING=false
